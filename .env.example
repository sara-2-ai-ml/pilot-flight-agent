# Copy to `.env` and fill in secrets. Never commit `.env` (it is gitignored).
#
# Quick start (mock mode, no API keys):
#   cp .env.example .env
#   python -m app.main
#
# Production-like local (natural language + planning via Claude):
#   Set ANTHROPIC_API_KEY, then NLU_USE_MOCK=false and PLANNER_USE_MOCK=false

# Application
APP_NAME=Pilot Flight Agent
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (Anthropic)
# Required when NLU_USE_MOCK=false and/or PLANNER_USE_MOCK=false.
# With mock=false, NLU extracts slots AND clarification replies use Claude (extra LLM calls per turn).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# true  = offline heuristics (tests, no API key). false = Claude NLU + natural conversational prompts.
NLU_USE_MOCK=true
# true  = rule-based planner. false = Claude planner.
PLANNER_USE_MOCK=true

# Note: values in this file override inherited shell env vars for NLU_USE_MOCK / PLANNER_USE_MOCK
# (so a stale NLU_USE_MOCK=true in your terminal does not silently override .env).

# Flight API — mock by default; set FLIGHT_API_USE_MOCK=false for live data
# Provider: lufthansa (OAuth2) | aviationstack (access_key query param)
FLIGHT_API_PROVIDER=aviationstack
FLIGHT_API_KEY=
FLIGHT_API_CLIENT_SECRET=
FLIGHT_API_BASE_URL=https://api.aviationstack.com/v1
FLIGHT_API_USE_MOCK=true

# Tool integration (direct | mcp)
TOOLS_MODE=direct
MCP_USE_INPROCESS=false
# MCP_PYTHON_EXECUTABLE=C:\Path\To\python.exe

# Booking store
BOOKING_DB_PATH=data/bookings.db

# Input guardrails
MIN_USER_MESSAGE_LENGTH=1
MAX_USER_MESSAGE_LENGTH=2000
PROMPT_INJECTION_GUARD_ENABLED=true
PROMPT_INJECTION_BLOCK=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IP_REQUESTS=30
RATE_LIMIT_CONVERSATION_REQUESTS=10
OUTPUT_GUARD_ENABLED=true
PII_REDACTION_ENABLED=true

# Reliability
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4.0
EXTERNAL_HTTP_TIMEOUT_SECONDS=10.0
EXTERNAL_MCP_TIMEOUT_SECONDS=15.0
EXTERNAL_LLM_TIMEOUT_SECONDS=30.0
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_OPEN_SECONDS=30

# Agent budget (raise MAX_LLM_CALLS if using NLU_USE_MOCK=false — clarification turns use extra calls)
MAX_ITERATIONS=8
MAX_LLM_CALLS=10
MAX_TOOL_CALLS=10
MAX_LATENCY_SECONDS=20
MAX_TOKENS=10000
MAX_STEP_RETRIES=3
MAX_REPLAN_ATTEMPTS=2
